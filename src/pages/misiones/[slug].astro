---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import Footer from '../../components/Footer.astro';
import Hoja from '../../components/Hoja.astro';
import Nav from '../../components/Nav.astro';
import PortadaMision from '../../components/PortadaMision.astro';
import { perfil } from '../../data/perfil';
import Base from '../../layouts/Base.astro';
import { numeroMision, obtenerMisiones } from '../../utils/misiones';
import { ruta } from '../../utils/rutas';

export const getStaticPaths = (async () => {
  const misiones = await obtenerMisiones();
  return misiones.map((mision, indice) => ({
    params: { slug: mision.id },
    props: {
      mision,
      numero: numeroMision(indice),
      anterior: misiones[indice - 1],
      siguiente: misiones[indice + 1],
    },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { mision, numero, anterior, siguiente } = Astro.props;
const { data } = mision;
const { Content } = await render(mision);

const enlaces = [
  { texto: 'Ver repositorio', url: data.repo },
  { texto: 'Ver demo', url: data.demo },
].filter((enlace): enlace is { texto: string; url: string } => Boolean(enlace.url));
---

<Base titulo={`${data.codigo} — ${data.titulo} · ${perfil.nombre}`} descripcion={data.resumen}>
  <Nav />
  <main id="contenido" tabindex="-1">
    <article class="contenedor caso capa-contenido" aria-labelledby="caso-titulo">
      <a class="caso__volver" href={ruta('/#misiones')}>
        <span aria-hidden="true">←</span> Volver a misiones
      </a>

      <header class="caso__cabecera">
        <Hoja />
        <p class="caso__meta">
          <span class="caso__numero">Misión {numero}</span>
          <span>{data.anio}</span>
          <span>{data.categoria}</span>
        </p>
        <h1 id="caso-titulo" class="caso__codigo">
          {data.codigo}
        </h1>
        <p class="caso__titulo">{data.titulo}</p>
        <p class="caso__resumen">{data.resumen}</p>
        {enlaces.length > 0 && (
          <ul class="caso__enlaces">
            {enlaces.map((enlace, indice) => (
              <li>
                <a
                  class:list={['boton', { 'boton--primario': indice === 0 }]}
                  href={enlace.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {enlace.texto} <span aria-hidden="true">↗</span>
                  <span class="sr-only">(se abre en otra pestaña)</span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </header>

      <div class:list={['caso__portada', { 'caso__portada--vacia': !data.imagen }]}>
        <PortadaMision mision={mision} sizes="(min-width: 1440px) 1296px, 100vw" prioridad />
      </div>

      <div class="caso__grilla">
        <div class="caso__relato">
          <section class="caso__bloque" aria-labelledby="caso-problema">
            <h2 id="caso-problema" class="etiqueta caso__subtitulo">
              El problema
            </h2>
            <p class="caso__destacado">{data.problema}</p>
          </section>
          <section class="caso__bloque" aria-labelledby="caso-solucion">
            <h2 id="caso-solucion" class="etiqueta caso__subtitulo">
              La solución
            </h2>
            <div class="prosa">
              <Content />
            </div>
          </section>
        </div>

        <aside class="caso__lateral" aria-label="Ficha de la misión">
          <section class="caso__ficha" aria-labelledby="caso-stack">
            <h2 id="caso-stack" class="etiqueta caso__subtitulo">
              El stack
            </h2>
            <ul class="lista-chips">
              {data.stack.map((tecnologia) => (
                <li class="chip chip--energia">{tecnologia}</li>
              ))}
            </ul>
          </section>
          <section class="caso__ficha caso__ficha--resultado" aria-labelledby="caso-resultado">
            <h2 id="caso-resultado" class="etiqueta caso__subtitulo">
              El resultado
            </h2>
            <p class="caso__resultado">{data.resultado}</p>
          </section>
        </aside>
      </div>

      <nav class="caso__vecinas" aria-label="Otras misiones">
        {anterior ? (
          <a class="caso__vecina" href={ruta(`/misiones/${anterior.id}/`)} rel="prev">
            <span class="etiqueta">
              <span aria-hidden="true">←</span> Misión anterior
            </span>
            <span class="caso__vecina-codigo">{anterior.data.codigo}</span>
          </a>
        ) : (
          <span />
        )}
        {siguiente && (
          <a
            class="caso__vecina caso__vecina--siguiente"
            href={ruta(`/misiones/${siguiente.id}/`)}
            rel="next"
          >
            <span class="etiqueta">
              Misión siguiente <span aria-hidden="true">→</span>
            </span>
            <span class="caso__vecina-codigo">{siguiente.data.codigo}</span>
          </a>
        )}
      </nav>
    </article>
  </main>
  <Footer />
</Base>

<style>
  .caso {
    padding-top: calc(var(--alto-nav) + clamp(32px, 5vw, 64px));
    padding-bottom: var(--espacio-seccion);
  }

  .caso__volver {
    display: inline-flex;
    gap: 10px;
    padding-block: 6px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--texto-78);
  }

  .caso__volver:hover {
    color: var(--color-dorado);
  }

  .caso__cabecera {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: clamp(32px, 5vw, 56px);
  }

  .caso__cabecera :global(.hoja) {
    margin-bottom: 28px;
  }

  .caso__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--texto-78);
  }

  .caso__numero {
    color: var(--acc);
  }

  .caso__codigo {
    font-family: var(--font-titulo);
    font-size: clamp(40px, 7vw, 100px);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: 0.05em;
    color: var(--color-dorado);
  }

  .caso__titulo {
    font-size: clamp(20px, 2vw, 26px);
    font-weight: 600;
  }

  .caso__resumen {
    max-width: 52ch;
    font-size: clamp(17px, 1.6vw, 20px);
    line-height: 1.55;
    color: var(--texto-88);
  }

  .caso__enlaces {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }

  .caso__portada {
    position: relative;
    aspect-ratio: 16 / 9;
    margin-top: clamp(40px, 5vw, 64px);
    overflow: hidden;
    border: 1px solid var(--borde-14);
    border-radius: var(--radio-grande);
    background: var(--color-panel-imagen);
    box-shadow: 0 0 60px -20px rgb(var(--accrgb) / 0.45);
  }

  /* Sin imagen real, el placeholder no necesita tanto alto. */
  @media (min-width: 48em) {
    .caso__portada--vacia {
      aspect-ratio: 21 / 9;
    }
  }

  .caso__grilla {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    align-items: start;
    gap: clamp(32px, 5vw, 72px);
    margin-top: clamp(48px, 6vw, 88px);
  }

  @media (min-width: 64em) {
    .caso__grilla {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    }

    .caso__lateral {
      position: sticky;
      top: calc(var(--alto-nav) + 32px);
    }
  }

  .caso__relato,
  .caso__lateral {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .caso__bloque {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .caso__subtitulo {
    font-weight: 400;
  }

  .caso__destacado {
    max-width: 60ch;
    font-size: clamp(19px, 1.8vw, 24px);
    font-weight: 500;
    line-height: 1.45;
  }

  .caso__ficha {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: clamp(22px, 2.4vw, 32px);
    border: 1px solid var(--borde-14);
    border-radius: var(--radio-tarjeta);
    background: var(--color-tarjeta);
  }

  .caso__ficha--resultado {
    border-color: rgb(var(--accrgb) / 0.5);
    box-shadow: 0 0 40px -16px rgb(var(--accrgb) / 0.5);
  }

  .caso__resultado {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.6;
    color: var(--color-blanco);
  }

  .caso__vecinas {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    margin-top: clamp(56px, 7vw, 104px);
    padding-top: 28px;
    border-top: 1px solid var(--borde-14);
  }

  .caso__vecina {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 6px 0;
  }

  .caso__vecina--siguiente {
    align-items: flex-end;
    margin-left: auto;
    text-align: right;
  }

  .caso__vecina-codigo {
    font-family: var(--font-titulo);
    font-size: clamp(20px, 2.4vw, 30px);
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-dorado);
    transition: text-shadow 0.3s;
  }

  .caso__vecina:hover .caso__vecina-codigo,
  .caso__vecina:focus-visible .caso__vecina-codigo {
    text-shadow: 0 0 18px rgb(var(--accrgb) / 0.8);
  }

  /* Texto del cuerpo Markdown (la solución). */
  .prosa {
    max-width: 65ch;
    font-size: 17px;
    line-height: 1.7;
    color: var(--texto-86);
  }

  .prosa :global(* + *) {
    margin-top: 1em;
  }

  .prosa :global(h3) {
    margin-top: 1.8em;
    font-family: var(--font-titulo);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-dorado);
  }

  .prosa :global(ul),
  .prosa :global(ol) {
    padding-left: 1.3em;
  }

  .prosa :global(li + li) {
    margin-top: 0.4em;
  }

  .prosa :global(li::marker) {
    color: var(--acc);
  }

  .prosa :global(a) {
    color: var(--color-texto);
    text-decoration: underline;
    text-decoration-color: rgb(var(--accrgb) / 0.8);
    text-underline-offset: 3px;
  }

  .prosa :global(a:hover) {
    color: var(--color-dorado);
  }

  .prosa :global(strong) {
    color: var(--color-blanco);
  }

  .prosa :global(code) {
    padding: 0.1em 0.4em;
    border-radius: 6px;
    background: rgb(243 238 231 / 0.08);
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .prosa :global(pre) {
    overflow-x: auto;
    padding: 18px;
    border: 1px solid var(--borde-14);
    border-radius: 14px;
    background: var(--color-tarjeta);
  }

  .prosa :global(pre code) {
    padding: 0;
    background: none;
  }

  .prosa :global(img) {
    border-radius: 16px;
  }

  .prosa :global(blockquote) {
    padding-left: 18px;
    border-left: 2px solid var(--acc);
    font-style: italic;
  }
</style>
