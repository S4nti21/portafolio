---
import Contacto from '../components/Contacto.astro';
import Entrenamiento from '../components/Entrenamiento.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Historia from '../components/Historia.astro';
import Nav from '../components/Nav.astro';
import { perfil } from '../data/perfil';
import Base from '../layouts/Base.astro';
---

<Base titulo={perfil.seo.titulo} descripcion={perfil.seo.descripcion} precargarSaga>
  <Nav />
  <main id="contenido" tabindex="-1">
    <Hero />
    <Historia />
    <Entrenamiento />
    <Contacto />
  </main>
  <Footer anclaArriba="inicio" />
</Base>
