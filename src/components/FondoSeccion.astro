---
import { Image } from 'astro:assets';
import { obtenerFondo, type NombreFondo } from '../utils/fondos';

interface Props {
  nombre: NombreFondo;
  /** Carga inmediata (solo para el fondo del inicio, que se ve apenas entra la página). */
  prioridad?: boolean;
}

const { nombre, prioridad = false } = Astro.props;
const imagen = obtenerFondo(nombre);
---

{imagen && (
  <div class:list={['fondo', 'capa-fondo', `fondo--${nombre}`]} aria-hidden="true">
    <Image class="fondo__imagen" src={imagen} alt="" layout="full-width" priority={prioridad} />
    <div class="fondo__velo" />
  </div>
)}

<style>
  .fondo__imagen,
  .fondo__velo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .fondo__imagen {
    object-fit: cover;
  }

  /* Capas oscuras de v3 para que el texto se lea sobre cualquier foto. */
  .fondo--hero .fondo__velo {
    background: linear-gradient(
      180deg,
      rgb(3 3 8 / 0.62) 0%,
      rgb(3 3 8 / 0.7) 55%,
      var(--color-fondo) 100%
    );
  }

  .fondo--entrenamiento .fondo__velo {
    background: linear-gradient(
      180deg,
      var(--color-fondo) 0%,
      rgb(3 3 8 / 0.8) 18%,
      rgb(3 3 8 / 0.8) 82%,
      var(--color-fondo) 100%
    );
  }

  /* Termina en el color de fondo para empalmar con el footer, que va fuera de la sección. */
  .fondo--contacto .fondo__velo {
    background: linear-gradient(
      180deg,
      var(--color-fondo) 0%,
      rgb(3 3 8 / 0.78) 25%,
      rgb(3 3 8 / 0.85) 85%,
      var(--color-fondo) 100%
    );
  }
</style>
