---
import { perfil } from '../data/perfil';
import { ruta } from '../utils/rutas';
import EncabezadoSeccion from './EncabezadoSeccion.astro';
import FondoSeccion from './FondoSeccion.astro';

const { contacto } = perfil;
const mailto = `mailto:${contacto.email}`;
const enlacesExternos = [
  { texto: 'LinkedIn', url: contacto.linkedin },
  { texto: 'GitHub', url: contacto.github },
];
---

<section id="contacto" class="seccion" aria-labelledby="contacto-titulo">
  <FondoSeccion nombre="contacto" />
  <div class="contenedor seccion__interior contacto capa-contenido">
    <EncabezadoSeccion seccion={perfil.secciones.contacto} idTitulo="contacto-titulo" grande />
    <p class="contacto__bajada">{contacto.bajada}</p>
    <a class="contacto__email" href={mailto}>
      {contacto.email}
    </a>

    <ul class="contacto__acciones">
      <li>
        <a class="boton boton--primario" href={mailto}>
          Escribime
        </a>
      </li>
      {enlacesExternos.map((enlace) => (
        <li>
          <a class="boton" href={enlace.url} target="_blank" rel="noopener noreferrer">
            {enlace.texto} <span aria-hidden="true">↗</span>
            <span class="sr-only">(se abre en otra pestaña)</span>
          </a>
        </li>
      ))}
      <li>
        <a class="boton" href={ruta(contacto.cv)} download>
          Descargar CV <span aria-hidden="true">↓</span>
        </a>
      </li>
      {contacto.mostrarTelefono && (
        <li>
          <a class="boton" href={`tel:${contacto.telefono.enlace}`}>
            <span class="sr-only">Teléfono:</span> {contacto.telefono.visible}
          </a>
        </li>
      )}
    </ul>
  </div>
</section>

<style>
  .contacto {
    padding-bottom: clamp(64px, 7vw, 100px);
  }

  .contacto__bajada {
    margin-top: 22px;
    font-size: clamp(22px, 2.4vw, 34px);
    font-weight: 500;
    line-height: 1.3;
  }

  .contacto__email {
    display: inline-block;
    margin-top: clamp(36px, 4vw, 56px);
    padding-bottom: 6px;
    border-bottom: 2px solid rgb(var(--accrgb) / 0.8);
    font-size: clamp(22px, 3.4vw, 48px);
    font-weight: 600;
    letter-spacing: -0.01em;
    word-break: break-word;
    transition:
      color 0.25s,
      border-color 0.25s;
  }

  .contacto__email:hover,
  .contacto__email:focus-visible {
    border-color: var(--color-blanco);
    color: var(--color-blanco);
  }

  .contacto__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
  }
</style>
