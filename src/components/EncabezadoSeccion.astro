---
import type { Seccion } from '../data/perfil';
import Hoja from './Hoja.astro';

interface Props {
  seccion: Seccion;
  /** id del título, para nombrar la sección con aria-labelledby. */
  idTitulo: string;
  /** Título más grande (lo usa Contacto). */
  grande?: boolean;
}

const { seccion, idTitulo, grande = false } = Astro.props;
---

<Hoja />
<p class="antetitulo">
  <span class="antetitulo__numero" aria-hidden="true">
    {seccion.numero}
  </span>
  <span>{seccion.etiqueta}</span>
</p>
<h2 id={idTitulo} class:list={['titulo', { 'titulo--grande': grande }]}>
  {seccion.titulo}
</h2>
<slot />

<style>
  .antetitulo {
    display: flex;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-texto);
  }

  .antetitulo__numero {
    color: var(--acc);
    transition: color 0.4s;
  }

  .titulo {
    margin-top: 18px;
    font-family: var(--font-titulo);
    font-size: clamp(30px, 4.6vw, 66px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-wrap: balance;
    color: var(--color-dorado);
  }

  .titulo--grande {
    margin-top: 22px;
    font-size: clamp(34px, 6.6vw, 100px);
    line-height: 1.02;
    letter-spacing: 0.04em;
  }
</style>
