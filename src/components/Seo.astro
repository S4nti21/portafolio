---
import { perfil } from '../data/perfil';
import { ruta } from '../utils/rutas';

interface Props {
  titulo: string;
  descripcion: string;
  /** Imagen para redes (URL absoluta o ruta del sitio). Por defecto, /og.png. */
  imagen?: string;
  /** Texto alternativo de la imagen para redes. */
  imagenAlt?: string;
  tipo?: 'website' | 'article';
  /** false agrega noindex (páginas que no aportan a los buscadores). */
  indexable?: boolean;
  /** Datos estructurados (schema.org) para buscadores. */
  datosEstructurados?: Record<string, unknown>;
}

const {
  titulo,
  descripcion,
  imagen = ruta('/og.png'),
  imagenAlt = `${perfil.nombre} · ${perfil.rol}`,
  tipo = 'website',
  indexable = true,
  datosEstructurados,
} = Astro.props;

const sitio = Astro.site ?? Astro.url;
const canonica = new URL(Astro.url.pathname, sitio).href;
const imagenAbsoluta = new URL(imagen, sitio).href;
const esImagenPorDefecto = imagen === ruta('/og.png');
// "<" escapado: el JSON va dentro de un <script> y no debe poder cerrarlo.
const jsonLd = datosEstructurados && JSON.stringify(datosEstructurados).replace(/</g, '\\u003c');
---

<title>{titulo}</title>
<meta name="description" content={descripcion} />
<link rel="canonical" href={canonica} />
{!indexable && <meta name="robots" content="noindex" />}

<link rel="icon" href={ruta('/favicon.svg')} type="image/svg+xml" />
<link rel="icon" href={ruta('/favicon.ico')} sizes="32x32" />
<link rel="apple-touch-icon" href={ruta('/apple-touch-icon.png')} />

<meta property="og:type" content={tipo} />
<meta property="og:site_name" content={perfil.nombre} />
<meta property="og:locale" content="es_AR" />
<meta property="og:title" content={titulo} />
<meta property="og:description" content={descripcion} />
<meta property="og:url" content={canonica} />
<meta property="og:image" content={imagenAbsoluta} />
{esImagenPorDefecto && (
  <>
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
  </>
)}
<meta property="og:image:alt" content={imagenAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={titulo} />
<meta name="twitter:description" content={descripcion} />
<meta name="twitter:image" content={imagenAbsoluta} />
<meta name="twitter:image:alt" content={imagenAlt} />

{jsonLd && <script type="application/ld+json" set:html={jsonLd}></script>}
